# Consolidated configuration reference. No real credentials belong in this file.
# Runtime files: apps/api/.env, apps/web/.env.local, apps/admin/.env.local.
# Copy the per-app .env.example templates as described in README.
# Keep PROXY_SECRET identical across the API and both frontends.

# API only: integration keys and database credentials stay server-side.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://commerce:development-only@127.0.0.1:5432/commerce
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
SHOP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
PROXY_SECRET=replace-with-at-least-32-random-characters
BRAND_NAME=Forme
SUPPORT_EMAIL=support@example.com
RESEND_API_KEY=
EMAIL_FROM=Forme <login@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit card-only payment-method configuration created in Stripe Dashboard
STRIPE_PAYMENT_METHOD_CONFIGURATION=
SHIPPING_COUNTRIES=
SHIPPING_PRICE_MINOR=0
# Set only after establishing a legally appropriate tax treatment
TAX_POLICY=
# Required when TAX_POLICY=included; explicit country rates in basis points
TAX_RATES_JSON={}
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=commerce-images
STORAGE_ACCESS_KEY_ID=commerce-storage
STORAGE_SECRET_ACCESS_KEY=development-storage-only
STORAGE_CDN_URL=http://127.0.0.1:9000/commerce-images

# Frontend configuration (both web and admin).
# API_INTERNAL_URL is server-only; NEXT_PUBLIC_* values are public.
# Set NEXT_PUBLIC_CDN_URL to the same CDN origin as STORAGE_CDN_URL.
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BRAND_NAME=Forme
NEXT_PUBLIC_SHOP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://127.0.0.1:9000/commerce-images

# Docker Compose local MinIO administration (development only).
MINIO_ROOT_USER=commerce-storage
MINIO_ROOT_PASSWORD=development-storage-only
