NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://commerce:development-only@127.0.0.1:5433/commerce
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
SHOP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
PROXY_SECRET=replace-with-at-least-32-random-characters
BRAND_NAME=Forme
SUPPORT_EMAIL=support@example.com
RESEND_API_KEY=
EMAIL_FROM=Forme <onboarding@resend.dev>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit card-only payment-method configuration created in Stripe Dashboard
STRIPE_PAYMENT_METHOD_CONFIGURATION=
SHIPPING_COUNTRIES=
SHIPPING_PRICE_MINOR=0
# Set only after establishing a legally appropriate tax treatment
TAX_POLICY=
# Required when TAX_POLICY=included; explicit country rates in basis points
TAX_RATES_JSON={}
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=commerce-images
STORAGE_ACCESS_KEY_ID=commerce-storage
STORAGE_SECRET_ACCESS_KEY=development-storage-only
STORAGE_CDN_URL=http://127.0.0.1:9000/commerce-images
