{
  "name": "@commerce/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc --noEmit && node ../../scripts/build-api.mjs",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx --env-file=.env src/modules/admin/bootstrap.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@commerce/contracts": "workspace:*",
    "@commerce/database": "workspace:*",
    "@commerce/email": "workspace:*",
    "better-auth": "1.7.7",
    "resend": "6.17.2",
    "stripe": "22.4.0",
    "bullmq": "5.81.2",
    "ioredis": "5.11.1",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "@aws-sdk/client-s3": "3.1095.0",
    "react": "19.3.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/express": "5.0.6",
    "esbuild": "0.28.2"
  }
}
