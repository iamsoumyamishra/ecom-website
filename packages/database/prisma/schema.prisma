generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Generated from Better Auth getAuthTables; do not guess or edit auth fields.
model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String            @default("CUSTOMER")
  disabled      Boolean           @default(false)
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  checkouts     CheckoutAttempt[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@unique([identifier])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient  String
  line1      String
  line2      String?
  city       String
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Product {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String
  category    String
  fabricCare  String
  status      String              @default("DRAFT")
  variants    ProductVariant[]
  images      ProductImage[]
  collections ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, id])
}

model ProductVariant {
  id           String                 @id @default(cuid())
  productId    String
  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku          String                 @unique
  size         String
  color        String
  priceMinor   Int
  currency     String                 @default("eur")
  inventory    Inventory?
  images       ProductImage[]
  cartItems    CartItem[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  @@unique([productId, size, color])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  storageKey String
  url        String
  alt        String
  position   Int             @default(0)

  @@index([productId, position])
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String
  products    ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Inventory {
  variantId String         @id
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  onHand    Int            @default(0)
  reserved  Int            @default(0)
  updatedAt DateTime       @updatedAt
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta     Int
  cause     String
  reference String?
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([variantId, createdAt])
}

model Cart {
  id        String            @id @default(cuid())
  userId    String?           @unique
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?           @unique
  items     CartItem[]
  checkouts CheckoutAttempt[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([cartId, variantId])
}

model CheckoutAttempt {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  cartId            String
  cart              Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  idempotencyKey    String
  requestHash       String
  providerSessionId String?                @unique
  providerUrl       String?
  state             String                 @default("CREATING")
  expiresAt         DateTime
  order             Order?
  reservations      InventoryReservation[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([state, updatedAt])
  @@index([cartId, state])
}

model InventoryReservation {
  id         String          @id @default(cuid())
  checkoutId String
  checkout   CheckoutAttempt @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  state      String          @default("HELD")

  @@unique([checkoutId, variantId])
}

model Order {
  id               String               @id @default(cuid())
  number           String               @unique
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkoutId       String               @unique
  checkout         CheckoutAttempt      @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  email            String
  paymentState     String               @default("PENDING")
  fulfillmentState String               @default("UNFULFILLED")
  shippingAddress  Json
  billingAddress   Json?
  subtotalMinor    Int
  shippingMinor    Int
  taxMinor         Int                  @default(0)
  discountMinor    Int                  @default(0)
  totalMinor       Int
  currency         String               @default("eur")
  items            OrderItem[]
  payments         Payment[]
  shipments        Shipment[]
  redemptions      DiscountRedemption[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId, id])
  @@index([createdAt, id])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId      String
  sku            String
  title          String
  size           String
  color          String
  quantity       Int
  unitPriceMinor Int
  taxMinor       Int    @default(0)
  discountMinor  Int    @default(0)

  @@index([orderId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerIntentId  String   @unique
  providerSessionId String   @unique
  amountMinor       Int
  currency          String   @default("eur")
  state             String
  refunds           Refund[]
  createdAt         DateTime @default(now())

  @@index([orderId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey   String   @unique
  providerRefundId String?  @unique
  amountMinor      Int
  status           String   @default("REQUESTED")
  reason           String
  actorId          String
  createdAt        DateTime @default(now())

  @@index([paymentId, status])
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  carrier           String
  trackingReference String
  shippedAt         DateTime  @default(now())
  deliveredAt       DateTime?

  @@unique([orderId, trackingReference])
}

model Discount {
  id          String               @id @default(cuid())
  code        String               @unique
  amountMinor Int
  usageLimit  Int
  allocated   Int                  @default(0)
  redeemed    Int                  @default(0)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean              @default(true)
  redemptions DiscountRedemption[]
}

model DiscountRedemption {
  id          String   @id @default(cuid())
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountMinor Int
  state       String   @default("HELD")
}

model WebhookEvent {
  id          String    @id
  type        String
  payload     Json
  state       String    @default("RECEIVED")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([state, createdAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  key         String    @unique
  type        String
  payload     Json
  state       String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([state, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  summary   Json
  createdAt DateTime @default(now())

  @@index([createdAt, id])
}

model MediaUpload {
  id         String   @id @default(cuid())
  actorId    String
  storageKey String   @unique
  mimeType   String
  size       Int
  alt        String
  state      String   @default("PENDING")
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([state, expiresAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
